# ============================================================
#  Pawan Portfolio — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to git.
# ============================================================

# ── MongoDB ─────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers → Node.js
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ── Email (Gmail SMTP) ───────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate an App Password for "Mail" → paste it here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Notifications ────────────────────────────────────────────
# Email address that receives new contact form submission alerts
NOTIFY_EMAIL=your.gmail@gmail.com

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS (production only) ───────────────────────────────────
# Your Vercel domain — e.g. https://pawan.vercel.app
# Leave empty in development
ALLOWED_ORIGIN=
